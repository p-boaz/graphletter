{
  "name": "graphletter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build --webpack",
    "build:strict": "ENFORCE_TYPECHECK=1 next build --webpack",
    "check:copy": "node scripts/check-copy-jargon.js",
    "check:spec": "node scripts/check-spec.js",
    "dev": "next dev",
    "lint": "eslint . --quiet",
    "lint:full": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "next start",
    "pretypecheck": "rm -rf .next/dev/types",
    "typecheck": "tsc --noEmit",
    "test:ui": "playwright test --headed",
    "test:ui:bg": "PLAYWRIGHT_HEADLESS=1 playwright test",
    "test:ui:critical": "playwright test playwright/tests/critical-path.spec.ts --headed",
    "test:ui:auth": "playwright test playwright/tests/auth.spec.ts --headed",
    "test:ui:debug": "playwright test --debug",
    "test:scf": "node --import tsx scripts/test-scf-parser.ts",
    "eval:artifact-classifier": "tsx scripts/eval-artifact-classifier.ts",
    "extract:scf": "node --import tsx scripts/extract-scf.ts",
    "seed": "node --import tsx scripts/seed-all.ts",
    "seed:snapshot": "node --import tsx scripts/snapshot-row-counts.ts",
    "seed:verify": "node --import tsx scripts/seed-verify.ts",
    "seed:reset": "node --import tsx scripts/seed-reset.ts",
    "test:integration": "node --import tsx --test \"tests/**/*.test.ts\" \"lib/**/*.test.ts\"",
    "schema:migrations:check": "node scripts/schema-migration-convention-check.js",
    "schema:drift:check": "node scripts/schema-drift-check.js",
    "qa:user:ensure": "node --import tsx scripts/qa-user-ensure.ts",
    "verify:scf-extraction": "node --import tsx scripts/verify-scf-extraction.ts",
    "verify:sheetjs-provenance": "node scripts/verify-sheetjs-provenance.js",
    "prepare": "husky",
    "manifest:generate": "node --import tsx scripts/generate-framework-manifest.ts",
    "manifest:check": "node --import tsx scripts/generate-framework-manifest.ts --check"
  },
  "dependencies": {
    "@ai-sdk/anthropic": "2.0.56",
    "@ai-sdk/openai": "2.0.88",
    "@hookform/resolvers": "^3.9.1",
    "@radix-ui/react-accordion": "^1.2.12",
    "@radix-ui/react-alert-dialog": "^1.1.15",
    "@radix-ui/react-aspect-ratio": "^1.1.8",
    "@radix-ui/react-avatar": "^1.1.11",
    "@radix-ui/react-checkbox": "^1.3.3",
    "@radix-ui/react-collapsible": "^1.1.12",
    "@radix-ui/react-context-menu": "^2.2.16",
    "@radix-ui/react-dialog": "^1.1.18",
    "@radix-ui/react-dropdown-menu": "^2.1.16",
    "@radix-ui/react-hover-card": "^1.1.15",
    "@radix-ui/react-label": "^2.1.8",
    "@radix-ui/react-menubar": "^1.1.16",
    "@radix-ui/react-navigation-menu": "^1.2.14",
    "@radix-ui/react-popover": "^1.1.15",
    "@radix-ui/react-progress": "^1.1.8",
    "@radix-ui/react-radio-group": "^1.3.8",
    "@radix-ui/react-scroll-area": "^1.2.10",
    "@radix-ui/react-select": "^2.2.6",
    "@radix-ui/react-separator": "^1.1.8",
    "@radix-ui/react-slider": "^1.3.6",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-switch": "^1.2.6",
    "@radix-ui/react-tabs": "^1.1.13",
    "@radix-ui/react-toast": "^1.2.15",
    "@radix-ui/react-toggle": "^1.1.10",
    "@radix-ui/react-toggle-group": "^1.1.11",
    "@radix-ui/react-tooltip": "^1.2.8",
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.88.0",
    "@tanstack/react-query": "^5.90.12",
    "@vercel/analytics": "^1.5.0",
    "ai": "5.0.115",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "cmdk": "^1.1.1",
    "csv-parse": "^6.1.0",
    "csv-stringify": "^6.7.0",
    "date-fns": "4.1.0",
    "dotenv": "^17.2.3",
    "embla-carousel-react": "^8.6.0",
    "input-otp": "^1.4.2",
    "lucide-react": "^0.454.0",
    "mammoth": "^1.11.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "node-fetch": "^3.3.2",
    "pdf-lib": "^1.17.1",
    "pdf-parse": "^2.4.5",
    "react": "^19.2.1",
    "react-day-picker": "^9.13.0",
    "react-dom": "^19.2.1",
    "react-dropzone": "^14.3.8",
    "react-hook-form": "^7.68.0",
    "react-icons": "^5.5.0",
    "react-resizable-panels": "^4.0.7",
    "sonner": "^2.0.7",
    "tailwind-merge": "^2.5.5",
    "tailwindcss-animate": "^1.0.7",
    "tesseract.js": "^7.0.0",
    "vaul": "^1.1.2",
    "xlsx": "https://cdn.sheetjs.com/xlsx-0.20.3/xlsx-0.20.3.tgz",
    "zod": "^4.2.1"
  },
  "devDependencies": {
    "@commitlint/cli": "^20.4.3",
    "@commitlint/config-conventional": "^20.4.3",
    "@playwright/test": "^1.55.0",
    "@tailwindcss/postcss": "^4.3.1",
    "@types/node": "^24",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "baseline-browser-mapping": "^2.10.0",
    "eslint": "^9.39.3",
    "eslint-config-next": "16.2.6",
    "husky": "^9.1.7",
    "lint-staged": "^16.3.2",
    "postcss": "^8.5",
    "prettier": "^3.6.2",
    "tailwindcss": "^4.3.1",
    "tsx": "^4.21.0",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "eslint --fix --quiet",
      "prettier --write"
    ],
    "*.{js,jsx}": [
      "eslint --fix --quiet",
      "prettier --write"
    ],
    "*.{json,md,css}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@10.33.4",
  "engines": {
    "node": "24.x"
  },
  "pnpm": {
    "overrides": {
      "glob@>=10.2.0 <10.5.0": "^10.5.0",
      "minimatch@<3.1.4": "^3.1.4",
      "minimatch@>=9.0.0 <9.0.7": "^9.0.7",
      "flatted@<3.4.2": "^3.4.2",
      "picomatch@<2.3.2": "^2.3.2",
      "picomatch@>=4.0.0 <4.0.4": "^4.0.4",
      "@xmldom/xmldom@<0.8.13": "^0.8.13",
      "underscore@<1.13.8": "^1.13.8",
      "fast-uri@<3.1.2": "^3.1.2",
      "ws@>=8.0.0 <8.21.0": "^8.21.0"
    }
  }
}
