# Copy to .env, then fill in at least one AI provider key before running:
# docker compose up --build

# Browser-facing URL. Keep localhost so the browser can reach the Supabase API.
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321

# Server/container-facing URL. Docker containers reach the Supabase CLI stack
# through the host gateway while the browser continues to use localhost.
SUPABASE_INTERNAL_URL=http://host.docker.internal:54321

# Supabase CLI local-development keys. These match `supabase status -o env`
# for the default local JWT secret in supabase/config.toml.
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6ImFub24iLCJleHAiOjE5ODM4MTI5OTZ9.CRXP1A7WOeoJeXxjNni43kdQwgnWNReilDMblYTn_I0
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZS1kZW1vIiwicm9sZSI6InNlcnZpY2Vfcm9sZSIsImV4cCI6MTk4MzgxMjk5Nn0.EGIM96RAZx35lJzdJsyH-qQwv8Hdp7fsn3W0YpN81IU

# At least one hosted provider key or local provider config is required for real
# assessments. To keep evidence local, set AI_PROVIDER=ollama and run Ollama on
# the host at OLLAMA_BASE_URL.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
AI_PROVIDER=openai
CONTROL_MAPPING_AI_PROVIDER=
AI_MODEL=
CONTROL_MAPPING_AI_MODEL=
OLLAMA_BASE_URL=http://host.docker.internal:11434/v1
OLLAMA_MODEL=llama3.1:8b
OLLAMA_API_KEY=

# Optional admin gates and logging.
ADMIN_USER_IDS=
ADMIN_EMAILS=
LOG_LEVEL=info
