# Copy this file to .env.local and fill in real values.
# .env.local is gitignored; never commit secrets.

# ---- Supabase ----
# Project URL and keys from your Supabase dashboard:
#   Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# ---- AI providers ----
# At least one of these is required. The app routes assessments to whichever
# is configured (see lib/ai-config.ts).
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# ---- Admin access (optional) ----
# Comma-separated allowlists consumed by utils/auth.ts to gate /admin/* routes.
# Provide either UUIDs, emails, or both. Leave blank to disable admin access locally.
ADMIN_USER_IDS=
ADMIN_EMAILS=

# ---- Optional ----
# LOG_LEVEL controls verbosity of @/lib/logger output.
# Values: "debug" | "info" | "warn" | "error" (default: "info")
LOG_LEVEL=info
