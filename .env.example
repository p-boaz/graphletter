# Copy this file to .env.local and fill in real values.
# .env.local is gitignored; never commit secrets.

# ---- Supabase ----
# Project URL and keys from your Supabase dashboard:
#   Settings -> API Keys
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=sb_secret_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Direct Postgres connection string. Required by `pnpm seed:reset` (the
# wipe-and-reseed orchestrator shells out to psql for the TRUNCATE step).
# Settings -> Database -> Connection string -> URI. Use the session-pooler
# (port 5432) connection; password is the same as the database password.
DATABASE_URL=postgresql://postgres.<project-ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres

# ---- AI providers ----
# At least one hosted provider key or a local Ollama config is required.
# See docs/AI_PROVIDERS.md for provider selection and fallback behavior.
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...

# Optional local/no-data-egress assessment provider. CONTROL_MAPPING_AI_PROVIDER
# overrides AI_PROVIDER when both are set.
AI_PROVIDER=openai
CONTROL_MAPPING_AI_PROVIDER=
AI_MODEL=
CONTROL_MAPPING_AI_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1
OLLAMA_MODEL=llama3.1:8b
OLLAMA_API_KEY=

# ---- Admin access (optional) ----
# Comma-separated allowlists consumed by utils/auth.ts to gate /admin/* routes.
# Provide either UUIDs, emails, or both. Leave blank to disable admin access locally.
ADMIN_USER_IDS=
ADMIN_EMAILS=

# ---- Optional ----
# LOG_LEVEL controls verbosity of @/lib/logger output.
# Values: "debug" | "info" | "warn" | "error" (default: "info")
LOG_LEVEL=info
