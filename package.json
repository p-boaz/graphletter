{
  "name": "graphletter",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "build": "next build",
    "build:strict": "ENFORCE_TYPECHECK=1 next build",
    "check:spec": "node scripts/check-spec.js",
    "dev": "next dev",
    "lint": "eslint . --quiet",
    "lint:full": "eslint .",
    "lint:fix": "eslint . --fix",
    "start": "next start",
    "pretypecheck": "rm -rf .next/dev/types",
    "typecheck": "tsc --noEmit",
    "test:ui": "playwright test --headed",
    "test:ui:bg": "PLAYWRIGHT_HEADLESS=1 playwright test",
    "test:ui:critical": "playwright test playwright/tests/critical-path.spec.ts --headed",
    "test:ui:auth": "playwright test playwright/tests/auth.spec.ts --headed",
    "test:ui:debug": "playwright test --debug",
    "test:scf": "tsx scripts/test-scf-parser.ts",
    "eval:artifact-classifier": "tsx scripts/eval-artifact-classifier.ts",
    "test:integration": "tsx --test tests/**/*.test.ts",
    "schema:migrations:check": "node scripts/schema-migration-convention-check.js",
    "schema:drift:check": "node scripts/schema-drift-check.js",
    "prepare": "husky"
  },
